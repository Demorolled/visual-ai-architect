{
  "spec": "training/fromscratch/SPEC.md",
  "version": 1,
  "goal": "knowledge-free code/scaffolding LLM, trained from random init",
  "acceptance": {
    "fkb_exact_match_max": 0.08,
    "fkb_probe_discrimination_min": 0.40,
    "scaffold_parse_min": 0.60,
    "per_slice_val_loss_max_delta": 2.0
  },
  "stacks": ["typescript", "tsx", "javascript", "jsx", "python", "html", "css", "json", "yaml", "shell", "sql"],
  "token_budget_pretrain": {
    "total_effective_tokens": 4000000000,
    "slices": {
      "code":        {"raw_tokens": 3000000000, "repeat": 1,  "effective_tokens": 3000000000, "share_pct": 75.0},
      "code_prose":  {"raw_tokens": 350000000,  "repeat": 1,  "effective_tokens": 350000000,  "share_pct": 8.8},
      "scaffold":    {"raw_tokens": 20000000,   "repeat": 10, "effective_tokens": 200000000,  "share_pct": 5.0},
      "simple_en":   {"raw_tokens": 450000000,  "repeat": 1,  "effective_tokens": 450000000,  "share_pct": 11.3}
    }
  },
  "sources": {
    "code":        {"kind": "external", "dataset": "bigcode/the-stack-smol | The Stack v2 (license-filtered)", "filter": "stacks + quality + dedup + secret-scrub"},
    "code_prose":  {"kind": "external", "dataset": "comments/docstrings/READMEs of the same code repos", "filter": "same repos only"},
    "scaffold":    {"kind": "internal", "paths": [
        "corpora/vaca (685 rows / 197 tasks, decontaminated, leak_threshold 0.2, n_dropped_leak 95)",
        "training/selfplay/corpus/vaca-domain.jsonl (1030 rows, 10 facets, coverage 100.0)",
        "training/selfplay/corpus/r1 + work traces (play/dpo/tune-up)"
    ]},
    "simple_en":   {"kind": "external", "dataset": "roneneldan/TinyStories", "filter": "drop proper nouns from banned list; fallback docs/narration"}
  },
  "banned": ["wikipedia", "news", "books", "commoncrawl-narrative", "web-qa", "world-fact-instruction-data", "llm-generated-knowledge-text"],
  "decontamination": {
    "held_out_ids_from": "corpora/vaca/meta.json",
    "code_holdout_frac": 0.02,
    "simple_en_holdout_frac": 0.01,
    "code_prose_holdout_frac": 0.01,
    "cross_slice_near_dup": true
  },
  "tokenizer": {"type": "byte-level-bpe", "vocab_size": 32768, "trained_on": "curated_mix_only",
                "specials": ["<|pad|>", "<|bos|>", "<|eos|>", "<|system|>", "<|user|>", "<|assistant|>"]},
  "models": {
    "nano-110m": {"d_model": 768, "layers": 12, "heads": 12, "head_dim": 64, "ffn": 2048, "context": 1024, "params_approx": 110000000, "tied_embeddings": true},
    "small-350m": {"d_model": 1024, "layers": 24, "heads": 16, "head_dim": 64, "ffn": 2816, "context": 2048, "params_approx": 342000000, "tied_embeddings": true}
  },
  "pretrain": {"optimizer": "adamw", "betas": [0.9, 0.95], "weight_decay": 0.1, "grad_clip": 1.0,
               "lr_nano": 6e-4, "lr_small": 3e-4, "warmup_steps": 2000, "schedule": "cosine_to_10pct",
               "eff_batch_tokens": 500000, "precision": "bf16", "eval_every": 250, "ckpt_every": 500, "seed": 42},
  "sft": {"method": "full_finetune", "epochs": 2, "lr": 1e-4, "schedule": "cosine", "seq": 1024, "batch": 8, "mask_to_assistant": true, "optional_dpo": true},
  "eval": {"fkb_file": "eval/forbidden.jsonl", "fkb_rows": 300, "results_file": "eval/results.json",
           "discrimination_model": "Qwen/Qwen2.5-Coder-1.5B-Instruct"}
}
