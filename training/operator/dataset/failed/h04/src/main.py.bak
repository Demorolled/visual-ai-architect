import sys

HABIT_STREAK = {'exercise': 0}

def track_habit(habit: str) -> bool:
    if HABIT_STREAK[habit] == 2:
        HABIT_STREAK[habit] = 0
        return True
    else:
        HABIT_STREAK[habit] += 1
        return False

def get_streak(habit: str) -> int:
    return HABIT_STREAK.get(habit, 0)

def main() -> None:
    track_habit('exercise')
    track_habit('exercise')
    track_habit('exercise')
    print(f'Current streak: {get_streak("exercise")}')

if __name__ == '__main__':
    main()