# ────────────────────────────────────────────────────────────────────────────
# Deep-scan P0 1.1 (TODO fixes.txt) — heavy training/build artifacts that
# must never be committed: the 9GB of GGUFs, 20G of cloud-training output,
# caches, LoRA adapters, and studio uploads. Everything else (source, docs,
# small datasets) IS tracked.
# ────────────────────────────────────────────────────────────────────────────
# Models (GGUF weights) — Modelfiles stay tracked
models/*.gguf

# Build / pipeline output
out/
curriculum/out/
training/cloud/out/

# LoRA adapters (regenerable training artifacts)
adapters/
adapters_raw/

# Dequantized HF checkpoints — rebuilt from a GGUF by training/unlearn/gguf_to_hf.py
# (~30GB each, so they must never be committed)
training/unlearn/models/

# Caches
huggingface_tokenizers_cache/
unsloth_compiled_cache/
__pycache__/
*.pyc
.pytest_cache/

# Training-studio uploads / data copies (metadata.json stays tracked)
llm-training-app/data/uploads/
backend/llm-training-app/data/

# Large third-party datasets (regenerable / downloadable)
data/rico/

# Backup dir referenced by deploy scripts (sits one level above the repo)
../model-backups/

# Dataset snapshot backups (63 timestamped copies of train.jsonl)
training/dataset/backup-*/

# Cloned dataset repos that keep their own git history
data/galaxy/

# ────────────────────────────────────────────────────────────────────────────
# Excluded before the first public push: internal tool state, runtime caches,
# regenerable LoRA smoke-test adapters (~345MB), and stray mistyped files.
# ────────────────────────────────────────────────────────────────────────────
.freebuff/
backend/.session_cache/
training/unlearn/adapters-smoke/
backend/--help
backend/-h

# ────────────────────────────────────────────────────────────────────────────
# Per-machine config and RUNTIME STATE — never sync these.
#
# They legitimately differ per box (model inventory, live PIDs, experiment
# state), and syncing one box's copy over the other's BREAKS it: llm-config.json
# pinned to a model the other box does not have made every build fail with
# `404 model 'vaca-r20-q4:latest' not found`. Cost a full reconciliation cycle
# of hand-resolution. Keep them local; each box owns its own.
# ────────────────────────────────────────────────────────────────────────────
backend/llm-config.json
scripts/dspark.pid
scripts/.terminal-speak-seen.json
data/micro-experiment-state.json
