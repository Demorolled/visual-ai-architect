   "code": "import { Task, TaskStore } from '../core-engine/core-engine.ts';\n\nexport class InputHandler {\n  private tasks: Task[] = [];\n\n  constructor() {}\n\n  addTask(title: string, description: string, status: 'TODO' | 'IN_PROGRESS' | 'DONE', assignedTo: string, priority: 'HIGH' | 'MEDIUM' | 'LOW') {\n    const id = Date.now();\n    this.tasks.push({ id, title, description, status, assignedTo, priority });\n  }\n\n  updateTask(id: number, title: string, description: string, status: 'TODO' | 'IN_PROGRESS' | 'DONE', assignedTo: string, priority: 'HIGH' | 'MEDIUM' | 'LOW') {\n    const task = this.tasks.find(t => t.id === id);\n    if (task) {\n      task.title = title;\n      task.description = description;\n      task.status = status;\n      task.assignedTo = assignedTo;\n      task.priority = priority;\n    }\n  }\n\n  deleteTask(id: number) {\n    this.tasks = this.tasks.filter(t => t.id !== id);\n  }\n\n  getTasks() {\n    return this.tasks;\n  }\n}",
