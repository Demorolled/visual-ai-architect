[TEMPLATE]
PORT=3001
DOCKER_ENABLED=false
SANDBOX_TIMEOUT=30000

# ── Idle micro-app experimenter (self-improvement loop) ─────────────────────
# OFF by default. Set IDLE_EXPERIMENTER_ENABLED=1 to have the LLM build micro-
# apps from the ground up during idle time, rewrite its own code to be smaller,
# faster, and more universal using data/micro-app-build-examples.md + the VACA
# library as reference, 👍/👎 each iteration, and store working improvements to
# data/micro-app-ideas.json (also fed back into the knowledge store).
IDLE_EXPERIMENTER_ENABLED=0
# Seconds of no user activity before the loop considers the app idle.
IDLE_EXPERIMENTER_THRESHOLD_MS=60000
# Min gap between idle-triggered runs (ms).
IDLE_EXPERIMENTER_COOLDOWN_MS=600000
# Hard safety cap on rewrite rounds; the loop normally stops at the plateau
# (2 consecutive non-improving attempts) before then.
IDLE_EXPERIMENTER_MAX_ROUNDS=6
# Per LLM generation timeout.
IDLE_EXPERIMENTER_LLM_TIMEOUT_MS=300000

# ── Mini-model judge / validator ────────────────────────────────────────────
# Set IDLE_EXPERIMENTER_JUDGE=1 to add an LLM review gate: every improved build
# is reviewed (completeness, universality, clarity) before being stored. To use
# a SMALL dedicated model (e.g. Qwen2.5-Coder 0.5B in Ollama), point at its
# OpenAI-compatible endpoint + model. Without these two, the judge falls back
# to the primary model.
IDLE_EXPERIMENTER_JUDGE=0
IDLE_EXPERIMENTER_JUDGE_MODEL=qwen2.5-coder:0.5b
# IDLE_EXPERIMENTER_JUDGE_BASE_URL=http://127.0.0.1:11434/v1
# ── DSpark (local GGUF server, scripts/start-dspark.sh → 127.0.0.1:8000) ─────
# 1 (default) = the backend may spawn DSpark itself when it is not running;
# 0 = it expects DSpark to be up already (the running box uses
#     scripts/runtime-up.sh) and falls back to Ollama if :8000 is unreachable.
DSPARK_AUTOSTART=1
# Launcher overrides, read by scripts/start-dspark.sh:
# DSPARK_PORT=8000
# DSPARK_HOST=127.0.0.1
# DSPARK_TARGET=/path/to/model.gguf
# DSPARK_MODEL_ID=my-model
